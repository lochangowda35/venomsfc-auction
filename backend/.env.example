# Optional local Flask CLI settings.
FLASK_RUN_HOST=127.0.0.1
FLASK_RUN_PORT=5000
FLASK_DEBUG=0
# Run `flask --app app configure-db` to verify and save real settings in .env.
# Leave these commented to run only the original HTTP demo without a database.
# PGHOST=127.0.0.1
# PGPORT=5432
# PGDATABASE=venomsfc_auction
# PGUSER=venomsfc_app
# PGPASSWORD=replace-with-your-private-app-password
# Run `flask --app app configure-host` after applying migrations.
# This generates HOST_PASSWORD_HASH and SECRET_KEY in ignored .env.
# Local HTTP only; HTTPS deployment must set SESSION_COOKIE_SECURE=1.
SESSION_COOKIE_SECURE=0
